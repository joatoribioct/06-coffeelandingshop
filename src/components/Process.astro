---
import { processSteps } from '../config/site';
import ImageSlot from './ImageSlot.astro';
---

<section id="proceso" class="bg-sand">
	<div class="container-page flex flex-col gap-12 py-[clamp(64px,8vw,112px)]">
		<div class="flex max-w-[60ch] flex-col gap-2.5">
			<span class="eyebrow text-espresso">Proceso</span>
			<h2 class="h2-section m-0 text-espresso">Del grano a la taza</h2>
		</div>
		<div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,230px),1fr))] gap-6">
			{processSteps.map((s, i) => (
				<div class="flex flex-col gap-3.5">
					<div class="relative aspect-[4/3] w-full">
						<ImageSlot id={`paso-${i + 1}`} placeholder={s.placeholder} class="rounded-xl" />
					</div>
					<span class="font-serif text-[32px] font-bold leading-none text-brown">{i + 1}</span>
					<h3 class="h3-card m-0">{s.title}</h3>
					<p class="m-0 text-base text-espresso">{s.text}</p>
				</div>
			))}
		</div>
	</div>
</section>
