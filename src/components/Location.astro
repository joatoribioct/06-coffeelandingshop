---
import { hours, site } from '../config/site';
import ImageSlot from './ImageSlot.astro';
---

<section id="ubicacion" class="bg-cream">
	<div class="container-page grid grid-cols-[repeat(auto-fit,minmax(min(100%,380px),1fr))] items-stretch gap-[clamp(32px,5vw,64px)] py-[clamp(64px,8vw,112px)]">
		<div class="flex flex-col gap-6">
			<span class="eyebrow text-brown">Visítanos</span>
			<h2 class="h2-section m-0 text-brown">Nuestra barra en la Zona Colonial</h2>
			<p class="m-0 text-espresso">{site.address}</p>
			<div class="flex flex-col border-t border-sand">
				{hours.map((h) => (
					<div class="flex justify-between gap-4 border-b border-sand py-3.5">
						<span>{h.days}</span><strong>{h.time}</strong>
					</div>
				))}
			</div>
			<a
				href="https://maps.google.com"
				target="_blank"
				rel="noopener"
				class="btn self-start border border-brown px-[22px] py-[15px] text-brown hover:bg-brown hover:text-cream"
			>Cómo llegar</a>
		</div>
		<div class="relative min-h-[360px] w-full">
			<ImageSlot id="mapa" placeholder="Mapa o foto del local" class="rounded-2xl" />
		</div>
	</div>
</section>
