---
import { site } from '../config/site';
import ImageSlot from './ImageSlot.astro';
---

<section id="inicio" class="bg-ink text-cream">
	<div class="container-page grid grid-cols-[repeat(auto-fit,minmax(min(100%,440px),1fr))] items-center gap-[clamp(40px,6vw,80px)] py-[clamp(48px,8vw,112px)]">
		<div class="flex flex-col gap-7">
			<div class="flex items-center gap-3">
				<span class="eyebrow rounded-full bg-sand px-3 py-1.5 text-ink">Tostado esta semana</span>
				{site.showHandwritten && <span class="font-script text-[26px] leading-none text-caramel">hecho a mano</span>}
			</div>
			<h1 class="m-0 text-balance font-serif text-[clamp(2.25rem,5vw,3.75rem)] font-bold leading-[1.1] tracking-[-0.02em] text-cream">
				Café de especialidad, hecho con arte
			</h1>
			<p class="m-0 max-w-[52ch] text-pretty text-sand">
				Granos de las montañas dominicanas, tostados en pequeños lotes y preparados por baristas que cuidan cada taza. Llega a tu puerta en menos de 48 horas.
			</p>
			<div class="flex flex-wrap gap-3.5">
				<a href="#productos" class="btn bg-caramel px-7 py-[18px] text-ink hover:-translate-y-0.5 hover:bg-brown hover:text-cream">Comprar café</a>
				<a href="#productos" class="btn border border-sand px-7 py-[17px] text-cream hover:border-caramel hover:text-caramel">Ver menú</a>
			</div>
		</div>
		<div class="relative aspect-[4/5] max-h-[640px] w-full">
			<ImageSlot id="hero-cafe" placeholder="Foto: taza negra con arte latte sobre madera" class="rounded-2xl" />
		</div>
	</div>
</section>
