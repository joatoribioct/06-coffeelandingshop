---
import { features } from '../config/site';
---

<section class="bg-cream">
	<div class="container-page grid grid-cols-[repeat(auto-fit,minmax(min(100%,230px),1fr))] gap-[clamp(28px,3vw,48px)] py-[clamp(56px,7vw,96px)]">
		{features.map((f, i) => (
			<div class="flex flex-col gap-3 border-t-2 border-caramel pt-5">
				<span class="eyebrow text-brown">{String(i + 1).padStart(2, '0')}</span>
				<h3 class="h3-card m-0">{f.title}</h3>
				<p class="m-0 text-base text-espresso">{f.text}</p>
			</div>
		))}
	</div>
</section>
