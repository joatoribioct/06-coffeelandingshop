---
import { testimonials } from '../config/site';
import ImageSlot from './ImageSlot.astro';
---

<section class="bg-cream">
	<div class="container-page flex flex-col gap-10 py-[clamp(64px,8vw,112px)]">
		<h2 class="h2-section m-0 text-brown">Lo que dicen nuestros clientes</h2>
		<div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,300px),1fr))] gap-6">
			{testimonials.map((t, i) => (
				<figure class="m-0 flex flex-col gap-5 rounded-2xl bg-card p-7 shadow-card">
					<blockquote class="m-0 font-serif text-xl font-medium leading-[1.45] text-ink">“{t.quote}”</blockquote>
					<figcaption class="mt-auto flex items-center gap-3">
						<div class="size-11 flex-none">
							<ImageSlot id={`cliente-${i + 1}`} class="rounded-full" />
						</div>
						<div class="flex flex-col leading-snug">
							<strong class="text-[15px]">{t.name}</strong>
							<span class="text-sm text-brown">{t.city}</span>
						</div>
					</figcaption>
				</figure>
			))}
		</div>
	</div>
</section>
